{
  "name": "deepjson-connector",
  "version": "2.0.0",
  "description": "Official connector for DeepJSON Server - JSON storage with real-time sync. Zero dependencies.",
  "main": "lib/index.cjs",
  "module": "lib/index.mjs",
  "browser": "dist/deepjson-connector.min.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "import": "./lib/index.mjs",
      "require": "./lib/index.cjs",
      "browser": "./dist/deepjson-connector.esm.js",
      "default": "./lib/index.cjs"
    }
  },
  "files": [
    "lib/",
    "dist/",
    "types/",
    "src/",
    "scripts/"
  ],
  "scripts": {
    "test": "node scripts/test.js",
    "build": "node scripts/clean.js && node scripts/build-umd.js && webpack --config webpack.config.js",
    "build:umd": "node scripts/build-umd.js",
    "prepublishOnly": "npm run build",
    "clean": "node scripts/clean.js"
  },
  "keywords": [
    "json",
    "database",
    "realtime",
    "sync",
    "storage",
    "connector",
    "key-value",
    "channel",
    "zero-dependency",
    "vanilla",
    "offline"
  ],
  "author": "cn.sntrk",
  "license": "GPL-3.0-only",
  "devDependencies": {
    "webpack": "^5.104.1",
    "webpack-cli": "^5.1.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hayde/deepjson-js-connector.git"
  },
  "bugs": {
    "url": "https://github.com/hayde/deepjson-js-connector.git/issues"
  },
  "engines": {
    "node": ">=18"
  }
}
